{
  "name": "@kovsh/api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend «Ковш на Час»: REST API + WebSocket",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "pnpm build && node --enable-source-maps dist/main.js",
    "db:migrate": "node dist/database/migrate.cli.js",
    "admin:create": "node dist/admin/create-admin.cli.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@kovsh/contracts": "workspace:*",
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/platform-socket.io": "^11.2.11",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/websockets": "^11.2.11",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "libphonenumber-js": "^1.13.17",
    "nestjs-pino": "^5.3.2",
    "otplib": "^12.0.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.11",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.3"
  }
}
